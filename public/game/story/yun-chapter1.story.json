              "by": 1
            }
          ],
          "hint": "变量影响：science +1"
        }
      ]
    },
    {
      "id": "T1_10",
      "title": "离宫",
      "scene": {
        "background": "bg_t1_10",
        "music": "SCORE_fairytale_air",
        "transition": "fade"
      },
      "steps": [
        {
          "type": "sfx",
          "audio": "SFX_snow_steps"
        },
        {
          "type": "sfx",
          "audio": "SFX_distant_paper_rip"
        },
        {
          "type": "line",
          "id": "T1_10_L01",
          "text": "王宫后门的雪阶很窄。鹿暝把黑伞收在臂弯；它不是能救王城的宝物，只是一条必须送出去的坏消息。"
        },
        {
          "type": "line",
          "id": "T1_10_L02",
          "text": "姐姐，你让人熄钟、撤灯，现在又抱着一把破伞逃宫。父王若看见——",
          "speaker": "prince_li"
        },
        {
          "type": "line",
          "id": "T1_10_L03",
          "text": "父王已经看不见了。正因为你不肯接受这件事，才请了那个画师。",
          "speaker": "luming"
        },
        {
          "type": "line",
          "id": "T1_10_L04",
          "text": "我只是不想让他被忘掉！宫里的人已经开始改口，仿佛他从没活过。那幅像本该比我们都长久。",
          "speaker": "prince_li"
        },
        {
          "type": "line",
          "id": "T1_10_L05",
          "text": "可你把‘记住一个人’做成了‘让全世界看见我们’。砾，我们现在连自己的影子都保不住。",
          "speaker": "luming"
        },
        {
          "type": "line",
          "id": "T1_10_L06",
          "text": "砾亲王张了张嘴。卫队火把把一排清楚的影子送向画室。他忽然回头，第一次亲手压低了火焰。"
        },
        {
          "type": "line",
          "id": "T1_10_L07",
          "text": "两位殿下要算旧账，最好等世界还有厚度的时候。西廊已经薄得能透过它看日出了。",
          "speaker": "huaiyi"
        },
        {
          "type": "line",
          "id": "T1_10_L08",
          "text": "砾亲王望向先王灵堂。遗像和墙正在一起变薄；所谓永恒，并没有认出是谁付的钱。"
        },
        {
          "type": "line",
          "id": "T1_10_L09",
          "text": "海边还有没被校过的船。先把规则送出去。谁能走、谁留下，到了港口再吵。",
          "speaker": "sailor"
        },
        {
          "type": "line",
          "id": "T1_10_L10",
          "text": "你走了，留下的人会叫你逃兵。",
          "speaker": "prince_li"
        },
        {
          "type": "line",
          "id": "T1_10_L11",
          "text": "那就让他们骂。总比只剩一幅不会骂人的画像好。",
          "speaker": "luming"
        },
        {
          "type": "line",
          "id": "T1_10_L12",
          "text": "鹿暝走下雪阶。身后传来砾亲王命人熄灭外墙灯火的声音——晚得救不了王宫，却还来得及少送出几个名字。"
        }
      ],
      "choices": [
        {
          "id": "T1_10_C01",
          "text": "立刻前往海边",
          "target": "chapter1.to_chapter2",
          "effects": [
            {
              "type": "inc",
              "key": "act1_done",
              "by": 1
            }
          ],
          "hint": "变量影响：act1_done +1"
        },
        {
          "id": "T1_10_C02",
          "text": "回头看最后一眼，确认画页扩散速度",
          "target": "T1_11",
          "effects": [
            {
              "type": "inc",
              "key": "clue_flatten",
              "by": 1
            },
            {
              "type": "inc",
              "key": "science",
              "by": 1
            }
          ],
          "hint": "变量影响：clue_flatten +1, science +1"
        }
      ]
    },
    {
      "id": "T1_11",
      "title": "一掌宽的世界",
      "scene": {
        "background": "bg_t1_11",
        "music": "SCORE_fairytale_air",
        "transition": "fade"
      },
      "steps": [
        {
          "type": "sfx",
          "audio": "SFX_low_rumble"
        },
        {
          "type": "sfx",
          "audio": "SFX_paper_rip_slow"
        },
        {
          "type": "line",
          "id": "T1_11_L01",
          "text": "城墙高处，一条安静的白沿石砖生长。鹿暝在纸边前撑开黑伞；白线迟疑片刻，随后从伞影两侧绕了过去。"
        },
        {
          "type": "line",
          "id": "T1_11_L02",
          "text": "它慢了一点。只一点。",
          "speaker": "huaiyi"
        },
        {
          "type": "line",
          "id": "T1_11_L03",
          "text": "因为伞让回光迟到。但王城的位置早已画在纸上，它不需要再问路。",
          "speaker": "sailor"
        },
        {
          "type": "line",
          "id": "T1_11_L04",
          "text": "所以黑伞不是挡住这一张纸，是让下一位画师不愿寻找下一座城。",
          "speaker": "luming"
        },
        {
          "type": "line",
          "id": "T1_11_L05",
          "text": "对。眼前能救人的，只有纸边尚未走完的这段时间。",
          "speaker": "sailor"
        },
        {
          "type": "line",
          "id": "T1_11_L06",
          "text": "鹿暝用匕首在城砖刻下两道线。白边经过第一道时，港口还能放下一艘船；经过第二道时，去海边的路就会断。"
        },
        {
          "type": "line",
          "id": "T1_11_L07",
          "text": "别只量墙。叫人去报港口还有多少床位、多少孩子、多少不会游水的老人。",
          "speaker": "huaiyi"
        },
        {
          "type": "line",
          "id": "T1_11_L08",
          "text": "还有粮、药和名字。尤其是名字。我们不能一边逃，一边学纸把人压成数字。",
          "speaker": "luming"
        },
        {
          "type": "line",
          "id": "T1_11_L09",
          "text": "纸边继续生长。它没有停下来听他们争论，却留下了一段可以行动、也可以被浪费的前奏。"
        },
        {
          "type": "line",
          "id": "T1_11_L10",
          "text": "潮向变了。再晚一刻，南港也会封。",
          "speaker": "sailor"
        },
        {
          "type": "line",
          "id": "T1_11_L11",
          "text": "走。把纸怎样找人、伞怎样藏人、还有伞为什么会变成牢，一句都别漏。",
          "speaker": "luming"
        },
        {
          "type": "line",
          "id": "T1_11_L12",
          "text": "第一则童话没有给鹿暝一件战胜怪物的法宝。它只让她分清三件事：何时该藏，何时已太晚，以及太晚以后还剩多少时间。"
        }
      ],
      "choices": [
        {
          "id": "T1_11_C01",
          "text": "记录完整警告：定位发生在前，慢光只能预防；纸边速度决定逃离窗口",
          "target": "chapter1.to_chapter2",
          "effects": [
            {
              "type": "inc",
              "key": "clue_spread_rate",
              "by": 1
            },
            {
              "type": "inc",
              "key": "science",
              "by": 1
            }
          ],
          "hint": "变量影响：clue_spread_rate +1, science +1"
        },
        {
          "id": "T1_11_C02",
          "text": "只记录画页与黑伞，不计算剩余撤离时间",
          "target": "chapter1.to_chapter2",
          "effects": [
            {
              "type": "inc",
              "key": "clue_flatten",
              "by": 1
            }
          ],
          "hint": "变量影响：clue_flatten +1"
        }
      ]
    },
    {
      "id": "chapter1.to_chapter2",
      "title": "通往饥潮之海",
      "scene": {
        "background": "bg_t2_01",
        "music": "BGM_11_hungry_sea",
        "transition": "fade"
      },
      "steps": [
        {
          "type": "line",
          "id": "chapter1_end_L01",
          "text": "第一则结束。鹿暝带走的不是护身伞，而是一条完整规则：光与回声会暴露世界；慢光能在暴露前封闭世界；暴露以后，只剩纸边抵达前的时间还能救人。"
        },
        {
          "type": "line",
          "id": "chapter1_end_L02",
          "speaker": "decoder",
          "text": "译码记录：画页代表降维打击；黑伞代表低光速黑域。黑域不是拦截武器，而是以永久封闭换取安全声明。"
        },
        {
          "type": "line",
          "id": "chapter1_end_L03",
          "speaker": "chengan",
          "text": "至少人物和技术没有混在一起了。坏消息是，听懂以后更难选。"
        },
        {
          "type": "line",
          "id": "chapter1_end_L04",
          "text": "海声覆盖铃声。第二盏灯在远处亮起，像一张正在张开的嘴。"
        }
      ],
      "choices": []
    },
    {
      "id": "chapter1.censored",
      "title": "通信中止",
      "steps": [
        {
          "type": "sfx",
          "audio": "SFX_signal_cut"
        },
        {
          "type": "line",
          "id": "E_CENSOR_L01",
          "text": "检测到直接技术规避。通信中止。",
          "speaker": "monitor_voice"
        },
        {
          "type": "line",
          "id": "E_CENSOR_L02",
          "text": "不，等等，他还没有讲完——",
          "speaker": "chengan"
        },
        {
          "type": "line",
          "id": "E_CENSOR_L03",
          "text": "三盏灯同时熄灭。译码舱里的星光像被掐断的呼吸，一粒一粒坠入黑暗。"
        },
        {
          "type": "line",
          "id": "E_CENSOR_L04",
          "text": "把缓存锁住。不要让它被自动清除。",
          "speaker": "decoder"
        },
        {
          "type": "line",
          "id": "E_CENSOR_L05",
          "text": "缓存封存。访问权限冻结。",
          "speaker": "monitor_voice"
        },
        {
          "type": "line",
          "id": "E_CENSOR_L06",
          "text": "童话没有死，它只是再也不能抵达你这里。你终于明白，太直白有时不是勇敢，而是替敌人完成截断。"
        }
      ],
      "choices": []
    }
  ]
}
